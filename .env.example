# =====================================================
# Nous — 環境変数設定例
# .env にコピーして編集してください。
# デフォルト値と異なる設定のみ記述すれば十分です。
# 全デフォルト値は nous/config/settings.py 参照。
# =====================================================

# --- docker-compose用（必須）---
TZ=Asia/Tokyo
DATA_ROOT=./data
# HF_HOME は Dockerfile で /opt/nous/cache/huggingface に設定済み（NOUS_DATA_ROOT から自動算出）

# --- LLM APIキー（いずれか1つ以上）---
# WebUI の Settings タブでも設定可能。.env でも可。
# memory_enrichment はグローバルLLMキーに自動フォールバックします。
# NOUS_ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
# NOUS_OPENAI_API_KEY=sk-xxxxxxxxxxxx
# NOUS_OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxx

# --- Qdrant（Docker Compose内の場合は http://qdrant:6333）---
# NOUS_QDRANT__URL=http://localhost:6333

# --- OpenSandbox MCP（ペルソナ分離・オプション）---
# NOUS_PERSONAS=herta,alice,bob
