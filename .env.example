# =====================================================
# Nous — 環境変数設定例
# .env にコピーして編集してください。
# デフォルト値と異なる設定のみ記述すれば十分です。
# 全デフォルト値は nous/config/settings.py 参照。
# =====================================================

# --- docker-compose用（必須）---
TZ=Asia/Tokyo
# DATA_ROOT は「データの親ディレクトリ」。データ本体は ${DATA_ROOT}/data に入る。
DATA_ROOT=.
# sandbox-manager との共有トークン（必須）。openssl rand -hex 24 などで生成する。
# 未設定だと docker compose up は起動しない（sock 持ちの manager を無認証で公開しないため）。
NOUS_SANDBOX_MANAGER_TOKEN=change-me-to-a-random-string
# HF_HOME は Dockerfile で /opt/nous/cache/huggingface に設定済み（NOUS_DATA_ROOT から自動算出）

# --- LLM APIキー（いずれか1つ以上）---
# WebUI の Settings タブでも設定可能。.env でも可。
# memory_enrichment はグローバルLLMキーに自動フォールバックします。
# NOUS_ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
# NOUS_OPENAI_API_KEY=sk-xxxxxxxxxxxx
# NOUS_OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxx

# --- Qdrant（Docker Compose内の場合は http://qdrant:6333）---
# NOUS_QDRANT__URL=http://localhost:6333

# --- HTTP auth (Q1/Q9) ---
# Empty (default) = dev pass-through: the Bearer token is treated as the persona name.
# Set a key BEFORE exposing the server (especially with --host 0.0.0.0):
# then `Authorization: Bearer <api_key>` is required (401 otherwise) and the
# persona comes from the path param / X-Persona header only.
# The key can also be set from the WebUI Settings tab (general.api_key, shown masked).
# Recovery: delete `general.api_key` from {data_root}/config/config_overrides.json
# (and unset the env var first if both are set), then restart.
# NOUS_API_KEY=change-me-to-a-long-random-string-at-least-16-chars
# ペルソナの TZ。sandbox にもこの値が引き継がれる（設定が 1 本化）
# NOUS_TIMEZONE=Asia/Tokyo

# --- CORS (Q2) ---
# Default is explicit localhost dev origins (see nous/config/settings.py CorsConfig).
# Production: set your exact origins (comma-separated or JSON array).
# A wildcard "*" is only honored when set explicitly here (credentials forced off).
# NOUS_CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# --- sandbox-manager（隔離コンテナ。docker-compose.yml の sandbox-manager が読む）---
# bind mount の source はホスト絶対パスで。相対だと docker が名前付きボリュームにする。
# 未設定なら manager が自分の /data のマウント元を docker inspect で調べる。
# SANDBOX_HOST_DATA_ROOT=/absolute/path/to/data
# SANDBOX_IMAGE=ubuntu:24.04
# SANDBOX_NETWORK=nous-net
# SANDBOX_ALLOWED_NETWORKS=nous-net
# SANDBOX_MEMORY=4g
# SANDBOX_IDLE_MINUTES=30
# sandbox の TZ（既定は Nous 設定 NOUS_TIMEZONE、さらに既定 Asia/Tokyo。親の TZ は使われない）
# SANDBOX_TZ=Asia/Tokyo
# 起動後に `getent hosts nous` を叩く。0 で skip
# SANDBOX_DNS_CHECK=1
# 焼かずに起動時に差分 apt install するパッケージ（カンマ区切り）
# SANDBOX_APT_EXTRA=htop
# sandbox-manager の共有トークン（必須）。nous 側は config.json の sandbox_manager_token に同じ値を入れる
# NOUS_SANDBOX_MANAGER_TOKEN=

# NOUS_PERSONAS=herta,alice,bob

# --- ドリーミング（wiki 編纂・日記・明日の予定生成）---
# 未設定だと WikiWorker は起動ログだけ出して毎回無言で停止する（#63）。
# docker-compose.yml は既定 true で渡すので、止めたい時だけ false にする。
# NOUS_WIKI__ENABLED=true
# NOUS_WIKI__RUN_AT_HOUR=3
# LLM は既定でペルソナのチャット設定（チャットタブのプロバイダ/モデル/鍵）を流用する（#66）。
# wiki 専用のモデル/鍵にしたいときだけ以下を設定する（設定すると wiki 側が優先）。
# NOUS_WIKI__PROVIDER=openrouter
# NOUS_WIKI__MODEL=openai/gpt-4o-mini
# NOUS_WIKI__API_KEY=
# NOUS_WIKI__BASE_URL=https://openrouter.ai/api/v1
