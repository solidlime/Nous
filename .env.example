# =====================================================
# Nous — 環境変数設定例
# .env にコピーして編集してください。
# デフォルト値と異なる設定のみ記述すれば十分です。
# 全デフォルト値は nous/config/settings.py 参照。
# =====================================================

# --- docker-compose用（必須）---
TZ=Asia/Tokyo
DATA_ROOT=./data
# HF_HOME は Dockerfile で /opt/nous/cache/huggingface に設定済み（NOUS_DATA_ROOT から自動算出）

# --- LLM APIキー（いずれか1つ以上）---
# WebUI の Settings タブでも設定可能。.env でも可。
# memory_enrichment はグローバルLLMキーに自動フォールバックします。
# NOUS_ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
# NOUS_OPENAI_API_KEY=sk-xxxxxxxxxxxx
# NOUS_OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxx

# --- Qdrant（Docker Compose内の場合は http://qdrant:6333）---
# NOUS_QDRANT__URL=http://localhost:6333

# --- HTTP auth (Q1/Q9) ---
# Empty (default) = dev pass-through: the Bearer token is treated as the persona name.
# Set a key BEFORE exposing the server (especially with --host 0.0.0.0):
# then `Authorization: Bearer <api_key>` is required (401 otherwise) and the
# persona comes from the path param / X-Persona header only.
# The key can also be set from the WebUI Settings tab (general.api_key, shown masked).
# Recovery: delete `general.api_key` from {data_root}/config/config_overrides.json
# (and unset the env var first if both are set), then restart.
# NOUS_API_KEY=change-me-to-a-long-random-string-at-least-16-chars

# --- CORS (Q2) ---
# Default is explicit localhost dev origins (see nous/config/settings.py CorsConfig).
# Production: set your exact origins (comma-separated or JSON array).
# A wildcard "*" is only honored when set explicitly here (credentials forced off).
# NOUS_CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# --- OpenSandbox MCP（ペルソナ分離・オプション）---
# NOUS_PERSONAS=herta,alice,bob
